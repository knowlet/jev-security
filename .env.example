# Copy this file to .env in the repository root. Never commit .env.
#
# Docker Compose reads this file automatically. For local npx/SDK use, export
# the same variables in your shell/environment.

# --- Codex / OpenAI-compatible Responses API ---

# Primary API key. OPENAI_API_KEY wins when both keys are set.
OPENAI_API_KEY=
CODEX_API_KEY=

# Optional base URL for the built-in OpenAI model provider.
# Must implement the OpenAI Responses API, not only Chat Completions.
# Example: https://api.openai.com/v1
OPENAI_BASE_URL=

# --- TypeSafe Jev bounded decision layer ---

# Enables Jev for dedupe screening and rubric-severity decisions.
TYPESAFE_API_KEY=

# Optional overrides; blank values use the built-in defaults.
# Defaults: https://api.typesafe.ai and jev-latest
TYPESAFE_BASE_URL=
TYPESAFE_DEFAULT_MODEL=

# --- Findings embeddings ---

# Optional full embeddings endpoint URL; blank uses the OpenAI default.
CODEX_SECURITY_EMBEDDINGS_URL=
